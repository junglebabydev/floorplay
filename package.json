    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.69.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "tailwindcss": "4.3.4",
    "typescript": "~5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
