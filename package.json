{
  "name": "floorplay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Turn a floor plan into a 3D home and see if your furniture fits. Bring your own AI.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
